// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl bypasses PgBouncer for migrations (prisma migrate, prisma db push).
  // The app never uses this — it always goes through DATABASE_URL.
  directUrl = env("DATABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum GameMode {
  standard
  pauper
  royal
}

enum TournamentFormat {
  single_elimination
  swiss
  round_robin
  arena
}

enum TournamentStatus {
  upcoming
  active
  finished
  cancelled
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Per-mode ELO
  eloStandard         Int @default(1200)
  eloPauper           Int @default(1200)
  eloRoyal            Int @default(1200)
  gamesPlayedStandard Int @default(0)
  gamesPlayedPauper   Int @default(0)
  gamesPlayedRoyal    Int @default(0)
  winsStandard        Int @default(0)
  winsPauper          Int @default(0)
  winsRoyal           Int @default(0)
  lossesStandard      Int @default(0)
  lossesPauper        Int @default(0)
  lossesRoyal         Int @default(0)
  drawsStandard       Int @default(0)
  drawsPauper         Int @default(0)
  drawsRoyal          Int @default(0)

  // Queue & game state
  queueStatus   String?   @default("offline")
  queuedAt      DateTime?
  queuedDraftId Int?
  queuedMode    GameMode?

  // Stripe
  stripeCustomerId String? @unique

  // Admin and moderation
  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?

  // Email verification
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Password reset
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Relations
  drafts             Draft[]
  queuedDraft        Draft?             @relation("UserQueuedDraft", fields: [queuedDraftId], references: [id], onDelete: SetNull)
  gamesAsPlayer1     Game[]             @relation("Player1")
  gamesAsPlayer2     Game[]             @relation("Player2")
  gamesAsWhite       Game[]             @relation("WhitePlayer")
  tokens             UserToken[]
  notifications      Notification[]
  tournamentEntries  TournamentPlayer[]
  following          UserFollow[]       @relation("Follower")
  followers          UserFollow[]       @relation("Following")
  sentRequests       FriendRequest[]    @relation("SentRequests")
  receivedRequests   FriendRequest[]    @relation("ReceivedRequests")
  sentChallenges     GameChallenge[]    @relation("SentChallenges")
  receivedChallenges GameChallenge[]    @relation("ReceivedChallenges")
  accounts           Account[]
  sessions           Session[]

  @@index([queueStatus])
  @@index([queuedDraftId])
  @@index([eloStandard])
  @@index([eloPauper])
  @@index([eloRoyal])
  @@index([isBanned])
  @@index([isAdmin])
  @@index([stripeCustomerId])
}

// ─── Draft ─────────────────────────────────────────────────────────────────────

model Draft {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String?
  fen       String
  points    Int
  mode      GameMode @default(standard)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  queuedByUsers User[]          @relation("UserQueuedDraft")
  gamesAsDraft1 Game[]          @relation("GameDraft1")
  gamesAsDraft2 Game[]          @relation("GameDraft2")
  challenges    GameChallenge[] @relation("ChallengeSenderDraft")

  @@index([userId])
  @@index([userId, mode])
  @@index([updatedAt])
}

// ─── Game ──────────────────────────────────────────────────────────────────────

model Game {
  id            Int      @id @default(autoincrement())
  player1Id     Int
  player2Id     Int
  whitePlayerId Int
  mode          GameMode @default(standard)
  status        String   @default("waiting")
  draft1Id      Int?
  draft2Id      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Position — final FEN written on game end, not updated during play
  // (active game FEN lives in Redis)
  fen           String?
  prepStartedAt DateTime?
  readyPlayer1  Boolean  @default(false)
  readyPlayer2  Boolean  @default(false)

  auxPointsPlayer1 Int @default(6)
  auxPointsPlayer2 Int @default(6)

  // Time control — final values written on game end
  lastMoveAt      DateTime?
  lastMoveBy      Int?
  moveNumber      Int       @default(0)
  player1Timebank Int       @default(60000)
  player2Timebank Int       @default(60000)

  // Result & ELO
  winnerId         Int?
  player1EloBefore Int?
  player2EloBefore Int?
  player1EloAfter  Int?
  player2EloAfter  Int?
  eloChange        Int?
  endReason        String?
  isFriendGame     Boolean @default(false)

  // PGN — built from Move table on game end and stored for fast replay access
  pgn String? @db.Text

  // Rematch
  rematchRequestedBy Int?

  // Tournament context
  tournamentId    Int?
  tournamentRound Int?

  // Relations
  player1    User        @relation("Player1",     fields: [player1Id],     references: [id], onDelete: Cascade)
  player2    User        @relation("Player2",     fields: [player2Id],     references: [id], onDelete: Cascade)
  whitePlayer User       @relation("WhitePlayer", fields: [whitePlayerId], references: [id], onDelete: Cascade)
  draft1     Draft?      @relation("GameDraft1",  fields: [draft1Id],      references: [id], onDelete: SetNull)
  draft2     Draft?      @relation("GameDraft2",  fields: [draft2Id],      references: [id], onDelete: SetNull)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  moves      Move[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([whitePlayerId])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
  @@index([draft1Id])
  @@index([draft2Id])
  @@index([winnerId])
  @@index([lastMoveAt])
  @@index([tournamentId])
  @@index([status, lastMoveAt])
  @@index([player1Id, mode, createdAt])
  @@index([player2Id, mode, createdAt])
}

// ─── Move ──────────────────────────────────────────────────────────────────────
// One row per move. Used to build PGN for the replayer and for game history.
// Written by the move route on every move.

model Move {
  id         Int    @id @default(autoincrement())
  gameId     Int
  moveNumber Int
  from       String // e.g. "e2"
  to         String // e.g. "e4"
  promotion  String? // "q" | "r" | "b" | "n" | null
  san        String  // Standard Algebraic Notation e.g. "e4", "Nf3", "O-O"
  fen        String  // FEN after this move — needed for replayer seek
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveNumber])
  @@index([gameId])
}

// ─── Tokens ────────────────────────────────────────────────────────────────────

model TokenDefinition {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  label       String
  description String?
  icon        String?
  color       String?
  adminOnly   Boolean @default(true)

  // Whether holding this token grants specific app privileges.
  // Checked via user-entitlements:{userId} Redis set at runtime.
  grantsPrivilege Boolean @default(false)

  createdAt DateTime @default(now())

  holders UserToken[]

  @@index([slug])
  @@index([grantsPrivilege])
}

model UserToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenId   Int
  grantedAt DateTime @default(now())
  grantedBy Int?     // userId of admin who granted, null if auto-granted or purchased

  // Expiry — null means permanent (achievement tokens, lifetime purchases)
  expiresAt DateTime?

  // Status: active | expired | revoked
  // expired: set by nightly cleanup job
  // revoked: set by admin action or ban
  status String @default("active")

  // Payment tracking (null for achievement tokens)
  stripePaymentIntentId String?

  note String?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token TokenDefinition @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@index([userId])
  @@index([tokenId])
  @@index([expiresAt])
  @@index([status])
  @@index([userId, status])
}

// ─── Stripe ────────────────────────────────────────────────────────────────────

// Idempotency table — Stripe can deliver webhooks more than once.
// Store the event ID and check before processing to prevent double-grants.
model StripeWebhookEvent {
  id        String   @id // Stripe event ID (evt_...)
  type      String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([processed])
}

// ─── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  // type values:
  //   friend_request | challenge | draw_offer | rematch_offer
  //   token_granted | token_expiring | token_expired
  //   tournament_starting | tournament_cancelled
  //   game_ended (for async result delivery)
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Tournament ────────────────────────────────────────────────────────────────

model Tournament {
  id                 Int              @id @default(autoincrement())
  name               String
  description        String?          @db.Text
  mode               GameMode         @default(standard)
  format             TournamentFormat @default(single_elimination)
  status             TournamentStatus @default(upcoming)
  registrationEndsAt DateTime?
  startsAt           DateTime?
  finishedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  maxPlayers         Int?
  minPlayers         Int              @default(2)
  prizeDescription   String?
  winnerId           Int?

  // Token slug required to enter. Null means open to all.
  // e.g. "tournament-entry" for a paid entry token
  requiredTokenSlug String?

  players TournamentPlayer[]
  games   Game[]

  @@index([status])
  @@index([mode])
  @@index([startsAt])
  @@index([requiredTokenSlug])
}

model TournamentPlayer {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  userId       Int
  registeredAt DateTime @default(now())
  score        Float    @default(0)
  rank         Int?
  eliminated   Boolean  @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([tournamentId, score])
}

// ─── Friends / Follow ──────────────────────────────────────────────────────────

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentRequests",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, status])
}

// ─── Game Challenges ───────────────────────────────────────────────────────────

model GameChallenge {
  id            Int      @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  mode          GameMode @default(standard)
  senderDraftId Int?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  sender      User   @relation("SentChallenges",       fields: [senderId],      references: [id], onDelete: Cascade)
  receiver    User   @relation("ReceivedChallenges",   fields: [receiverId],    references: [id], onDelete: Cascade)
  senderDraft Draft? @relation("ChallengeSenderDraft", fields: [senderDraftId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, status])
  @@index([expiresAt])
}

// ─── Auth ──────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
